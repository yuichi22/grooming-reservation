# Cloud Functions の環境変数 (firebase-functions が functions/.env を読み込む)。

# 中央 CRM / ポイント台帳の受信 Webhook (§10)。
# CRM 構築前は空のままで可 → イベントは pointEvents に pending で貯まり、
# URL 設定後に retryPointEvents が自動で配信する。
CRM_WEBHOOK_URL=

# 前日リマインド (§9) の LINE Messaging API チャネルアクセストークン。
# 本来はテナント単位 (tenants/{id}.lineConfig.messagingChannelAccessToken) が優先。
# 単一テナント運用時のフォールバック。空なら送信せず skip。
LINE_CHANNEL_ACCESS_TOKEN=

# 開発用 LINE トークンバイパス ("dev:<userId>") を許可するか (§2 顧客認証)。
# true のときだけ verifyLineAccessToken が "dev:" トークンを信用する。
# ⚠ 本番では必ず未設定（無効）にすること。設定すると誰でも任意の LINE ユーザに
# 成りすませる認証バイパスになる。
# ⚠ このフラグは .env には書かない（.env は prod にも乗る）。設置先は DEPLOY.md 参照:
#   ローカル/E2E → functions/.env.local / dev デプロイ → functions/.env.groomhaus-dev
#   prod → 設定しない。
ALLOW_DEV_LINE_TOKEN=

# POS(mobile_order)会計依頼伝票の受け口URL（①会計連携、Bearer は CRM_WEBHOOK_SECRET を共用）
POS_CHECKOUT_URL=

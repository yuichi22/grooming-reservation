{
  "name": "groom-reservation-saas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ペットトリミング予約 SaaS (GROOM HAUS / DECOLLE Inc.)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "e2e": "node functions/e2e.mjs",
    "deploy:dev": "npm run build && firebase deploy --project dev",
    "deploy:prod": "npm run build && firebase deploy --project prod"
  },
  "dependencies": {
    "@line/liff": "^2.24.0",
    "firebase": "^10.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  }
}

# Firebase Web SDK config (Project settings > Your apps > SDK setup)
# dev は groomhaus-dev / prod は groomhaus-prod のキーを設定 (§12)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# LINE / LIFF (テナント単位で Firestore tenants/{tenantId}.lineConfig に保持。
# 開発時のフォールバックとしてのみ使用) (§2 / §4)
# VITE_LIFF_ID を空にすると顧客フロー(/book)は開発モード(モック LINE ユーザ)で動く。
VITE_LIFF_ID=
# OA 友だち追加URL（例: https://lin.ee/xxxx）。友だち未追加ゲートの「友だち追加する」ボタンに使用。
# 未設定でもゲートは機能する（ボタンの代わりに店頭QRの案内文を表示）。
VITE_LINE_ADD_FRIEND_URL=

# 顧客向け LIFF (/book) の既定テナント。URL ?tenant= で上書き可。
VITE_DEFAULT_TENANT_ID=groomhaus
